<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read the recent-apps list. This is a user-granted switch (Settings ->
         Apps -> Special access -> Usage access), not a runtime permission; without
         it the recent row falls back to apps opened from IndieHost itself. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ hides other packages unless they are declared here.
         Without this, getLaunchIntentForPackage("net.perfectdreams.butterscotch")
         always returns null even when the runner is installed. -->
    <queries>
        <package android:name="net.perfectdreams.butterscotch" />

        <!-- Lets the app drawer see every installed app that has a launcher
             icon, i.e. exactly what a drawer is meant to show. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.IndieHost">

        <!-- HOME is what makes this a real launcher: pressing Home lands here,
             and that role is also what grants shortcut host permission, which
             we need to list and start Butterscotch's pinned game shortcuts.
             singleTask keeps one instance alive, so Home returns to this screen
             instead of reloading it. LAUNCHER stays so it can also be opened
             from another drawer. -->
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Offline RPG Maker MV/MZ runtime. Not exported: only the adapter in
             this same app starts it, by action and with an explicit package. -->
        <activity
            android:name=".GameWebViewActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.IndieHost">
            <intent-filter>
                <action android:name="com.indiehost.launcher.GAME_WEBVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Answers "Add Shortcut to Home Screen" requests from Butterscotch.
             Android only allows pinning when the current home app declares this
             action, and a pin is recorded against the accepting launcher, so
             this is what makes a pinned game show up in our list. -->
        <activity
            android:name=".PinShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
