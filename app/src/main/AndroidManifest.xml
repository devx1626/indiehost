<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ hides other packages unless they are declared here.
         Without this, getLaunchIntentForPackage("net.perfectdreams.butterscotch")
         always returns null even when the runner is installed. -->
    <queries>
        <package android:name="net.perfectdreams.butterscotch" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.IndieHost">

        <!-- HOME is declared so the user can pick IndieHost as the home app.
             That is what grants shortcut host permission, which we need to
             list and start Butterscotch's pinned game shortcuts. LAUNCHER
             stays so the app can also be opened from an app drawer. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
