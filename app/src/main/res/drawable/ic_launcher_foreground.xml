<?xml version="1.0" encoding="utf-8"?>
<!--
    IndieHost's mark: a cyan ring around a play triangle, with two curls of
    soft curls rising off it. Drawn on the 108dp adaptive-icon grid and kept inside
    the 66dp safe zone, so no mask (circle, squircle, teardrop) can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cyan ring. -->
    <path
        android:pathData="M34,56 a20,20 0 1,1 40,0 a20,20 0 1,1 -40,0"
        android:strokeColor="#66C0F4"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Play triangle. -->
    <path
        android:pathData="M49,45 L69,56 L49,67 Z"
        android:fillColor="#F2F7FB" />

    <!-- Game-client inspired. -->
    <path
        android:pathData="M70,36 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
        android:fillColor="#66C0F4"
        android:fillAlpha="0.55" />
    <path
        android:pathData="M79,28 m-2.8,0 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0"
        android:fillColor="#C6D4DF"
        android:fillAlpha="0.45" />
</vector>
